input {
    keyboard {
        repeat-delay 250
        repeat-rate 40
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        accel-profile "flat"
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// Run `niri msg outputs` and add `output "<name>" { mode "..."; position x=0 y=0 }`
// blocks here if the defaults are not right.

layout {
    gaps 6
    background-color "transparent"
    center-focused-column "never"
    default-column-width { proportion 1.0; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    focus-ring {
        off
    }
    border {
        width 1
    }
}

cursor {
    xcursor-theme "catppuccin-mocha-lavender-cursors"
    xcursor-size 24
}

workspace "chat"
workspace "games"

prefer-no-csd
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
}

environment {
    NIXOS_OZONE_WL "1"
    XDG_CURRENT_DESKTOP "niri"
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
window-rule {
    match app-id="^discord$"
    match app-id="^signal$"
    open-on-workspace "chat"
}
window-rule {
    match app-id="^steam$"
    match app-id="^lutris$"
    match app-id="^heroic$"
    open-on-workspace "games"
}
window-rule {
    match app-id="^steam$" title="^Friends List$"
    match app-id="^steam$" title="^Steam Settings$"
    match title="^Bitwarden$"
    match app-id="^xdg-desktop-portal-gtk$"
    match app-id="^org.freedesktop.impl.portal.desktop.kde$"
    open-floating true
}
window-rule {
    match title="^Picture.in.[Pp]icture$"
    open-floating true
    default-column-width { fixed 640; }
    default-window-height { fixed 360; }
    default-floating-position x=24 y=24 relative-to="bottom-right"
}
window-rule {
    match app-id="^steam$" title=r#"^notificationtoasts_\d+_desktop$"#
    open-floating true
    open-focused false
    default-floating-position x=12 y=12 relative-to="bottom-right"
}

// Show the noctalia wallpaper behind workspaces in the overview (Mod+O).
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T { spawn "kitty"; }
    Mod+B { spawn "brave"; }
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Escape { spawn "noctalia" "msg" "session" "lock"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+N { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+T { spawn "noctalia" "msg" "theme-mode-toggle"; }
    Mod+Q { close-window; }

    // focus / move (vim keys)
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Shift+K { move-window-up-or-to-workspace-up; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    // monitors
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    // workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // layout
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+M { maximize-column; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+O { toggle-overview; }
    Mod+Tab { focus-workspace-previous; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // screenshots
    Print { spawn "noctalia" "msg" "screenshot-region" "--copy-to-clipboard" "--no-save-to-file"; }
    Shift+Print { spawn "noctalia" "msg" "screenshot-region" "--save-to-file" "--copy-to-clipboard"; }
    Mod+Shift+S { spawn "noctalia" "msg" "screenshot-region" "--annotate"; }
    Ctrl+Print { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Alt+Print { spawn "noctalia" "msg" "screenshot-window"; }

    // screen recording (noctalia/screen_recorder plugin, gpu-screen-recorder)
    Mod+Shift+R { spawn "noctalia" "msg" "plugin" "noctalia/screen_recorder:service" "all" "toggle" "region"; }
    Mod+Ctrl+R { spawn "noctalia" "msg" "plugin" "noctalia/screen_recorder:service" "all" "toggle" "focused"; }

    // media / brightness
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}

// Generated by noctalia's "niri" template (border/focus-ring/tab colours).
// optional=true so niri still starts before noctalia has written it.
include optional=true "noctalia.kdl"
